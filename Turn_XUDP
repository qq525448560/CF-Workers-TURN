import { connect } from 'cloudflare:sockets'

const UUID = 'e258977b-e413-4718-a3af-02d75492c349'

/*
  TURN TCP/TLS SERVER
  推荐:
  turns:your.turn.server:5349?transport=tcp

  示例:
  const TURN_HOST = '1.2.3.4'
  const TURN_PORT = 5349
*/

const TURN_HOST = '47.83.122.49'
const TURN_PORT = 3478
const TURN_USER = ''
const TURN_PASS = ''

const textDecoder = new TextDecoder()
const textEncoder = new TextEncoder()

const MAGIC = new Uint8Array([0x21, 0x12, 0xA4, 0x42])

const STUN = {
  ALLOCATE_REQUEST: 0x0003,
  ALLOCATE_RESPONSE: 0x0103,

  SEND_INDICATION: 0x0016,
  DATA_INDICATION: 0x0017,

  CREATE_PERMISSION_REQUEST: 0x0008,

  XOR_PEER_ADDRESS: 0x0012,
  DATA: 0x0013,
  USERNAME: 0x0006,
  REALM: 0x0014,
  NONCE: 0x0015,
  TRANSPORT: 0x0019,
  MESSAGE_INTEGRITY: 0x0008,
  ERROR_CODE: 0x0009
}

function uuidToBytes(uuid) {
  const hex = uuid.replace(/-/g, '')
  const out = new Uint8Array(16)

  for (let i = 0; i < 16; i++) {
    out[i] = parseInt(hex.substr(i * 2, 2), 16)
  }

  return out
}

const UUID_BYTES = uuidToBytes(UUID)

function concat(...arrs) {
  const len = arrs.reduce((s, x) => s + x.length, 0)
  const out = new Uint8Array(len)

  let off = 0

  for (const a of arrs) {
    out.set(a, off)
    off += a.length
  }

  return out
}

function u16(b, o = 0) {
  return (b[o] << 8) | b[o + 1]
}

function randomTid() {
  return crypto.getRandomValues(new Uint8Array(12))
}

function pad4(n) {
  return (-n) & 3
}

function stunAttr(type, value) {
  const out = new Uint8Array(4 + value.length + pad4(value.length))

  const dv = new DataView(out.buffer)

  dv.setUint16(0, type)
  dv.setUint16(2, value.length)

  out.set(value, 4)

  return out
}

function stunMsg(type, attrs = []) {
  const tid = randomTid()

  const body = concat(...attrs)

  const out = new Uint8Array(20)

  const dv = new DataView(out.buffer)

  dv.setUint16(0, type)
  dv.setUint16(2, body.length)

  out.set(MAGIC, 4)
  out.set(tid, 8)

  return concat(out, body)
}

function xorPeer(ip, port) {
  const out = new Uint8Array(8)

  out[1] = 1

  const dv = new DataView(out.buffer)

  dv.setUint16(2, port ^ 0x2112)

  ip.split('.').forEach((v, i) => {
    out[4 + i] = Number(v) ^ MAGIC[i]
  })

  return out
}

function parseStun(data) {
  if (data.length < 20) return null

  const dv = new DataView(data.buffer, data.byteOffset, data.byteLength)

  const type = dv.getUint16(0)
  const len = dv.getUint16(2)

  const attrs = {}

  let off = 20

  while (off + 4 <= 20 + len) {
    const t = dv.getUint16(off)
    const l = dv.getUint16(off + 2)

    if (off + 4 + l > data.length) break

    attrs[t] = data.slice(off + 4, off + 4 + l)

    off += 4 + l + pad4(l)
  }

  return {
    type,
    attrs
  }
}

function parseXorPeer(data) {
  if (!data || data.length < 8) return null

  const ip = MAGIC.map((m, i) => data[4 + i] ^ m).join('.')

  const port = u16(data, 2) ^ 0x2112

  return { ip, port }
}

function parseVLESS(chunk) {
  if (chunk.length < 24) return null

  for (let i = 0; i < 16; i++) {
    if (chunk[i + 1] !== UUID_BYTES[i]) {
      return null
    }
  }

  const optLen = chunk[17]

  const cmd = chunk[18 + optLen]

  if (cmd !== 2) {
    return null
  }

  const port = u16(chunk, 19 + optLen)

  const atyp = chunk[21 + optLen]

  let host = ''
  let off = 22 + optLen

  if (atyp === 1) {
    host = [...chunk.slice(off, off + 4)].join('.')
    off += 4
  } else if (atyp === 2) {
    const len = chunk[off]
    off += 1

    host = textDecoder.decode(chunk.slice(off, off + len))
    off += len
  } else {
    return null
  }

  return {
    host,
    port,
    data: chunk.slice(off)
  }
}

function makeVLESSResp(data) {
  return concat(
    new Uint8Array([0, 0]),
    data
  )
}

async function readPacket(reader) {
  const { done, value } = await reader.read()

  if (done || !value) return null

  return new Uint8Array(value)
}

async function createTurn() {
  const socket = connect({
    hostname: TURN_HOST,
    port: TURN_PORT
  })

  await socket.opened

  const writer = socket.writable.getWriter()
  const reader = socket.readable.getReader()

  const transport = new Uint8Array([17, 0, 0, 0])

  const allocate = stunMsg(
    STUN.ALLOCATE_REQUEST,
    [
      stunAttr(STUN.TRANSPORT, transport)
    ]
  )

  await writer.write(allocate)

  const pkt = await readPacket(reader)

  if (!pkt) {
    throw new Error('turn allocate fail')
  }

  return {
    writer,
    reader,
    socket
  }
}

export default {
  async fetch(req) {
    if (req.headers.get('Upgrade') !== 'websocket') {
      return new Response('ok')
    }

    const pair = new WebSocketPair()

    const client = pair[0]
    const ws = pair[1]

    ws.accept()

    let turn = null

    const close = () => {
      try {
        turn?.socket?.close()
      } catch {}

      try {
        ws.close()
      } catch {}
    }

    try {
      turn = await createTurn()
    } catch (e) {
      return new Response(
        'TURN CONNECT FAIL: ' + String(e),
        { status: 500 }
      )
    }

    ;(async () => {
      try {
        while (true) {
          const pkt = await readPacket(turn.reader)

          if (!pkt) break

          const stun = parseStun(pkt)

          if (!stun) continue

          if (stun.type !== STUN.DATA_INDICATION) {
            continue
          }

          const peer = parseXorPeer(
            stun.attrs[STUN.XOR_PEER_ADDRESS]
          )

          const payload =
            stun.attrs[STUN.DATA]

          if (!peer || !payload) {
            continue
          }

          ws.send(
            makeVLESSResp(payload)
          )
        }
      } catch {
        close()
      }
    })()

    ws.addEventListener('message', async e => {
      try {
        const data = new Uint8Array(e.data)

        const v = parseVLESS(data)

        if (!v) return

        const peerAttr = stunAttr(
          STUN.XOR_PEER_ADDRESS,
          xorPeer(v.host, v.port)
        )

        const perm = stunMsg(
          STUN.CREATE_PERMISSION_REQUEST,
          [peerAttr]
        )

        await turn.writer.write(perm)

        const send = stunMsg(
          STUN.SEND_INDICATION,
          [
            peerAttr,
            stunAttr(STUN.DATA, v.data)
          ]
        )

        await turn.writer.write(send)
      } catch {
        close()
      }
    })

    ws.addEventListener('close', close)

    ws.addEventListener('error', close)

    return new Response(null, {
      status: 101,
      webSocket: client
    })
  }
}
