import { connect } from 'cloudflare:sockets';

const uuid = 'e258977b-e413-4718-a3af-02d75492c349';
const maxED = 8192;

const hexToBytes = hex => {
  const arr = new Uint8Array(hex.length / 2);
  for (let i = 0; i < arr.length; i++) {
    arr[i] = parseInt(hex.substr(i * 2, 2), 16);
  }
  return arr;
};

const base64ToBytes = b64 => {
  b64 = b64.replace(/-/g, '+').replace(/_/g, '/');
  while (b64.length % 4) b64 += '=';
  const bin = atob(b64);
  return Uint8Array.from(bin, c => c.charCodeAt(0));
};

export default {
  async fetch(req) {
    try {
      if (req.headers.get('Upgrade') !== 'websocket') {
        return new Response('ok', { status: 200 });
      }

      return await ws(req);
    } catch (e) {
      return new Response(String(e), { status: 500 });
    }
  }
};

const idB = hexToBytes(uuid.replaceAll('-', ''));

const dec = new TextDecoder();

const u16 = (b, o = 0) => (b[o] << 8) | b[o + 1];

const checkUUID = c => {
  if (c.length < 17) return false;

  for (let i = 0; i < idB.length; i++) {
    if (c[i + 1] !== idB[i]) return false;
  }

  return true;
};

const addr = (t, b) =>
  t === 3
    ? dec.decode(b)
    : t === 1
    ? b.join('.')
    : t === 4
    ? `[${Array.from({ length: 8 }, (_, i) =>
        u16(b, i * 2).toString(16)
      ).join(':')}]`
    : '';

const parseAddr = (b, o, t) => {
  const l =
    t === 3
      ? b[o++]
      : t === 1
      ? 4
      : t === 4
      ? 16
      : 0;

  return l && o + l <= b.length
    ? {
        addrBytes: b.subarray(o, o + l),
        dataOffset: o + l
      }
    : null;
};

const vless = c => {
  if (!checkUUID(c)) return null;

  const o = 19 + c[17];

  const t = c[o + 2] === 1 ? 1 : c[o + 2] + 1;

  const a = parseAddr(c, o + 3, t);

  return a
    ? {
        addrType: t,
        ...a,
        port: u16(c, o)
      }
    : null;
};

const relay = async (rd, send, close) => {
  try {
    for (;;) {
      const { done, value } = await rd.read();

      if (done) break;

      if (value?.byteLength) send(value);
    }
  } catch {}

  close();
};

const dial = async (h, p) => {
  const s = connect({
    hostname: h,
    port: p
  });

  await s.opened;

  return s;
};

const safeClose = (...a) =>
  a.forEach(x => {
    try {
      x?.close?.();
    } catch {}
  });

const ws = async req => {
  const pair = new WebSocketPair();

  const client = pair[0];
  const server = pair[1];

  server.accept();

  let sock = null;
  let writer = null;

  const close = () => {
    safeClose(sock, server);
  };

  const send = d => {
    try {
      server.send(d);
    } catch {}
  };

  const process = async chunk => {
    if (writer) {
      await writer.write(chunk);
      return;
    }

    const v = vless(chunk);

    if (!v) {
      close();
      return;
    }

    send(new Uint8Array([chunk[0], 0]));

    const {
      addrType,
      addrBytes,
      dataOffset,
      port
    } = v;

    const host = addr(addrType, addrBytes);

    if (!host) {
      close();
      return;
    }

    try {
      sock = await dial(host, port);
    } catch {
      close();
      return;
    }

    writer = sock.writable.getWriter();

    const payload = chunk.subarray(dataOffset);

    if (payload.byteLength) {
      await writer.write(payload);
    }

    relay(
      sock.readable.getReader(),
      send,
      close
    );
  };

  try {
    const ed = req.headers.get('sec-websocket-protocol');

    if (ed?.length && ed.length <= maxED) {
      try {
        await process(base64ToBytes(ed));
      } catch {}
    }

    server.addEventListener('message', async e => {
      try {
        let data;

        if (e.data instanceof ArrayBuffer) {
          data = new Uint8Array(e.data);
        } else if (e.data?.buffer) {
          data = new Uint8Array(e.data.buffer);
        } else {
          data = new Uint8Array(await e.data.arrayBuffer());
        }

        await process(data);
      } catch {
        close();
      }
    });

    server.addEventListener('close', close);

    server.addEventListener('error', close);

    return new Response(null, {
      status: 101,
      webSocket: client
    });
  } catch (e) {
    close();

    return new Response(String(e), {
      status: 500
    });
  }
};
