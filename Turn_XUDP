import { connect } from 'cloudflare:sockets';

// ==========================================
// 配置区：对应链接中的 <uuid>
// ==========================================
const UUID = 'your-uuid-here'; // 必须与客户端链接中的 UUID 一致

// ==========================================
// 一、系统入口与 WebSocket 握手
// ==========================================
export default {
  async fetch(req) {
    if (req.headers.get('Upgrade') !== 'websocket') {
      return new Response('ok', { status: 200 });
    }
    
    // 提取链接中 path 带的 TURN 信息
    // 链接格式: /turn://user:pass@turn_host:3478?ed=2560
    const turnInfo = getTurn(req.url);
    if (!turnInfo) return new Response('Missing TURN Config', { status: 400 });

    // 处理 0-RTT Early Data (ed=2560)
    // 客户端将首包塞入 sec-websocket-protocol
    const earlyData = req.headers.get('Sec-WebSocket-Protocol') || '';
    
    const pair = new WebSocketPair();
    const [client, server] = Object.values(pair);
    server.accept();

    // 异步处理代理逻辑
    handleProxy(server, turnInfo, earlyData);

    return new Response(null, {
      status: 101,
      webSocket: client,
    });
  }
};

// ==========================================
// 二、解析 path 中的 TURN URL
// ==========================================
const getTurn = url => {
  // 从 /turn://u:p@host:port?ed=2560 中提取 u:p@host:port
  const m = decodeURIComponent(url).match(/\/turn:\/\/([^?&#\s]*)/i);
  if (!m) return null;
  const t = m[1];
  
  // 分离 user:pass 和 host:port
  const at = t.lastIndexOf('@');
  const cred = t.substring(0, at);
  const hp = t.substring(at + 1);
  
  const ci = cred.indexOf(':');
  const [host, port] = hp.split(':');
  
  return {
    user: cred.substring(0, ci),
    pass: cred.substring(ci + 1),
    host: host,
    port: parseInt(port) || 3478
  };
};

// ==========================================
// 三、DoH 解析目标域名 (第二种 DNS)
// ==========================================
async function resolveIP(host) {
  const resp = await fetch(`https://cloudflare-dns.com/dns-query?name=${host}&type=A`, {
    headers: { 'Accept': 'application/dns-json' }
  });
  const data = await resp.json();
  return data.Answer[0].data;
}

// ==========================================
// 四、代理核心逻辑
// ==========================================
async function handleProxy(ws, turnInfo, earlyDataStr) {
  // 1. 建立到 TURN 的 TCP 连接 (第一种 DNS，Workers 内部自动解析)
  const ctrl = await connect({ hostname: turnInfo.host, port: turnInfo.port });
  const writer = ctrl.writable.getWriter();
  const reader = ctrl.readable.getReader();

  try {
    // 2. TURN Allocate 流程
    await writer.write(stunMsg(MT.AQ)); // Allocate Request
    let resp = await reader.read();
    
    // 处理 401 认证 (MD5 + HMAC-SHA1)
    const authResp = turnAuth(resp, turnInfo.user, turnInfo.pass);
    await writer.write(stunMsg(MT.AQ, authResp)); // Authenticated Allocate
    resp = await reader.read();

    // 3. 解析客户端首包
    let firstPacket;
    if (earlyDataStr) {
      firstPacket = base64Decode(earlyDataStr);
    } else {
      // 如果没有 Early Data，等待 WS 发送
      firstPacket = await readWsMessage(ws);
    }

    // 4. 解析 VLESS 协议头
    const { addrType, addrBytes, port, cmd, payload } = parseVLESS(firstPacket, UUID);
    if (!addrBytes) { ws.close(); return; }
    
    let targetHost = addr(addrType, addrBytes);
    
    // 5. 目标地址解析 (TURN Permission 必须指定 IP)
    const targetIP = addrType === 1 ? targetHost : await resolveIP(targetHost);

    // 6. CreatePermission 允许访问目标 IP
    await writer.write(stunMsg(MT.CP, { ip: targetIP }));

    if (cmd === 0x02 || isUDP(port)) {
      // ==============================
      // UDP 逻辑 (XUDP -> TURN SendIndication)
      // 绕过 Workers UDP 限制的核心
      // ==============================
      const { host: udpHost, port: udpPort, payload: udpData } = parseXUDP(payload);
      const udpTargetIP = udpHost.match(/\d+\.\d+\.\d+\.\d+/) ? udpHost : await resolveIP(udpHost);

      // 发送 TURN SendIndication (Worker 自己不发 UDP，由 TURN 代发)
      await writer.write(sendIndication({ ip: udpTargetIP, port: udpPort, data: udpData }));

      // 监听 TURN 返回的 DataIndication
      relayTurnUdpToWs(reader, ws);

    } else {
      // ==============================
      // TCP 逻辑 (TURN TCP Connect - RFC6062)
      // ==============================
      await writer.write(stunMsg(MT.CR, { ip: targetIP, port })); // Connect Request
      resp = await reader.read();
      const connId = parseConnectionId(resp);

      await writer.write(stunMsg(MT.CB, { connId })); // ConnectionBind
      await writer.write(payload); // 发送 TCP 首包剩余数据

      // 双向管道转发
      relay(ctrl.readable.getReader(), ws);
    }
  } catch (e) {
    console.error(e);
    ws.close();
  }
}

// ==========================================
// 五、协议解析辅助函数
// ==========================================

// VLESS 协议解析
function parseVLESS(buffer, uuid) {
  // 略: 校验 UUID，解析 Version, Cmd, AddrType, Addr, Port
  // 返回目标地址信息和除去 VLESS 头的 Payload
  return { addrType: 1, addrBytes: [], port: 443, cmd: 0x01, payload: buffer };
}

// XUDP 封包解析 (解决 WebSocket 是流而 UDP 是包的问题)
function parseXUDP(buffer) {
  // 略: 解析出目标 host, port, payload
  return { host: '8.8.8.8', port: 53, payload: buffer };
}

// TCP 无限循环 pipe
async function relay(reader, ws) {
  try {
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      ws.send(value);
    }
  } catch (e) {}
}

// UDP 回包监听 (TURN DataIndication -> WebSocket)
async function relayTurnUdpToWs(reader, ws) {
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    const udpPayload = parseDataIndication(value);
    ws.send(packXUDP(udpPayload)); // 重新打包为 XUDP 流发回客户端
  }
}

// STUN/TURN 报文构造器 (简化表示)
function stunMsg(type, attrs) { return new Uint8Array([]); }
function turnAuth(resp, user, pass) { return {}; }
